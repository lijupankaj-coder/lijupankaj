# Public browser configuration. The publishable key is safe to expose; RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SECRET_KEY=sb_secret_replace_me
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres
DATABASE_SSL=require
CMS_ADMIN_EMAIL=your-approved-admin@example.com
SITE_URL=https://preview.example.com
MEDIA_BUCKET=cms-media
CMS_SNAPSHOT_PATH=/app/data/published-content.json

# Runtime and upload limits.
PORT=3000
HOSTNAME=0.0.0.0
UPLOAD_MAX_IMAGE_MB=12
UPLOAD_MAX_PDF_MB=10
